Mplus VERSION 8.11 (Mac)
MUTHEN & MUTHEN
10/09/2026  12:49 PM

INPUT INSTRUCTIONS

  TITLE:      Invariance

  DATA:       FILE = FMA_AB3.csv;

  VARIABLE:

  NAMES =  ID SEX BIPOC VFMA1 HFMA1 VFMA3 HFMA3 VFMA4 HFMA4;
  					
  USEVARIABLES = VFMA1 HFMA1 VFMA3 HFMA3 VFMA4
  	     HFMA4 SEX;
  	
  IDVARIABLE = ID;
  						
  MISSING ARE ALL (-999);

  ANALYSIS:

  ESTIMATOR = MLR;
  PROCESSOR = 7;
  MODEL = NOCOV;

  MODEL:

  ! Create between components (random intercepts)
              RIx BY VFMA1@1 VFMA3@1 VFMA4@1;
              RIy BY HFMA1@1 HFMA3@1 HFMA4@1;

              ! Create within-person centered variables
              wx1 BY VFMA1@1;
              wx2 BY VFMA3@1;
              wx3 BY VFMA4@1;

              wy1 BY HFMA1@1;
              wy2 BY HFMA3@1;
              wy3 BY HFMA4@1;

              ! Constrain measurement error variances to 0
              VFMA1-HFMA4@0;

              ! Estimate lagged effects between within-person centered variables
              wx2 ON wx1;
              wy2 ON wy1;
              wx3 ON wx2;
              wy3 ON wy2;

              wx2 ON wy1;
              wy2 ON wx1;
              wx3 ON wy2;
              wy3 ON wx2;

              ! Estimate covariance between random intercepts
              RIx WITH RIy;
              RIx RIy ON SEX;

              ! Estimate covariance between within-person components at first wave
              wx1 WITH wy1;

              ! Estimate covariances between residuals of within-person components
              ! (i.e., innovations)
              wx2 WITH wy2;
              wx3 WITH wy3;

  OUTPUT:     TECH1 STDYX SAMPSTAT CINTERVAL;





