Mplus VERSION 9 (Mac)
MUTHEN & MUTHEN
09/24/2026  11:01 AM

INPUT INSTRUCTIONS

  TITLE:      SEX RI-CLPM FREE Full Group

  DATA:       FILE = FMA_AB3.csv;

  VARIABLE:

  NAMES =  ID SEX BIPOC VFMA1 HFMA1 VFMA3 HFMA3 VFMA4 HFMA4;
  					
  USEVARIABLES = VFMA1 HFMA1 VFMA3 HFMA3 VFMA4
  	     HFMA4 SEX;
  	
  GROUPING = SEX (0 = MALE 1 = FEMALE);
  	
  IDVARIABLE = ID;
  						
  MISSING ARE ALL (-999);

  ANALYSIS:

  ESTIMATOR = MLR;
  PROCESSOR = 7;
  MODEL = NOCOV;

  MODEL:

  ! Create between components (random intercepts)
              RIx BY VFMA1@1 VFMA3@1 VFMA4@1;
              RIy BY HFMA1@1 HFMA3@1 HFMA4@1;

              ! Create within-person centered variables
              wx1 BY VFMA1@1;
              wx2 BY VFMA3@1;
              wx3 BY VFMA4@1;

              wy1 BY HFMA1@1;
              wy2 BY HFMA3@1;
              wy3 BY HFMA4@1;

              ! Constrain measurement error variances to 0
              VFMA1-HFMA4@0;

              ! Estimate lagged effects between within-person centered variables
              wx2 ON wx1 (1);
              wy2 ON wy1 (2);
              wx3 ON wx2 (3);
              wy3 ON wy2 (4);

              wx2 ON wy1 (5);
              wy2 ON wx1 (6);
              wx3 ON wy2 (7);
              wy3 ON wx2 (8);

              ! Estimate covariance between random intercepts
              RIx WITH RIy (m1);

              ! Estimate covariance between within-person components at first wave
              wx1 WITH wy1;

              ! Estimate covariances between residuals of within-person components
              ! (i.e., innovations)
              wx2 WITH wy2;
              wx3 WITH wy3;

  MODEL FEMALE:   ! Overrule multiple group factor analysis default of equal intercepts
              ! across groups
              [VFMA1-HFMA4];

              ! Overrule multiple group factor analysis default of free latent means
              ! in second group
              [wx1-wy3@0];
              [RIx@0 RIy@0];

              ! Estimate lagged effects between within-person centered variables
              wx2 ON wx1 (1);
              wy2 ON wy1 (2);
              wx3 ON wx2 (3);
              wy3 ON wy2 (4);

              wx2 ON wy1 (5);
              wy2 ON wx1 (6);
              wx3 ON wy2 (7);
              wy3 ON wx2 (8);

              ! Estimate covariance between random intercepts
              RIx WITH RIy (m2);

  MODEL TEST:
     m1 = m2;

  OUTPUT:     TECH1 TECH4 STDYX SVALUES SAMPSTAT CINTERVAL;





INPUT READING TERMINATED NORMALLY



